---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CodCentral — Kenya\'s Premier Digital Marketing Agency',
  description = 'We position your brand for credibility, trust and sales that grow your business. 39 clients, 3 countries, Sh190M in client revenue.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#001854" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/codcentral-logo.png" />
    <link rel="apple-touch-icon" href="/codcentral-logo.png" />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
