---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Thank You — CodCentral"
  description="We received your message and will get back to you within one business day."
>
  <Navbar client:load />

  <main class="bg-primary min-h-screen flex items-center justify-center px-6 pt-24 pb-20">
    <div class="flex flex-col items-center text-center gap-6 max-w-lg">
      <div class="w-16 h-16 rounded-full bg-secondary/15 flex items-center justify-center">
        <svg class="w-8 h-8 text-secondary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h1 class="text-4xl font-black text-white tracking-tight">Message Received!</h1>
      <p class="text-white/60 text-base leading-relaxed">
        Thank you for reaching out. A member of our team will get back to you within one business day.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-secondary text-white font-bold text-sm tracking-wide hover:bg-red-600 hover:scale-105 transition-all duration-200 mt-2"
      >
        Back to Home
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
