---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar';
import Portfolio from '../components/Portfolio';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Our Works — CodCentral Digital Agency"
  description="Real clients, real results. See how CodCentral has helped brands across Kenya, Australia and Pakistan grow through strategy, technology and imagination."
>
  <Navbar baseUrl={import.meta.env.BASE_URL} client:load />
  <main class="pt-24">
    <Portfolio client:load />
  </main>
  <Footer />
</BaseLayout>
